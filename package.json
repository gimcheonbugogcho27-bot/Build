{
  "name": "guselpick-desktop",
  "version": "1.0.0",
  "description": "구슬 뽑기 Windows 데스크톱 앱",
  "main": "main.js",
  "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win nsis --publish never"
},

  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "kr.school.guselpick",
    "productName": "구슬 뽑기",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "구슬 뽑기"
    }
  }
}
